    "apollo-server-express": "^3.13.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "graphql-upload-ts": "^2.1.2",
    "i18n-iso-countries": "^7.14.0",
