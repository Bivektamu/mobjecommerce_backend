    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
